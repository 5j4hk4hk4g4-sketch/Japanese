{
  "hotel-h1": {
    "file": "hotel-h1.mp3",
    "hash": "230977937a7b",
    "voice": "ja-JP-NanamiNeural",
    "text": "いらっしゃいませ。こんにちは！"
  },
  "hotel-h2": {
    "file": "hotel-h2.mp3",
    "hash": "37802ff8ce20",
    "voice": "ja-JP-NanamiNeural",
    "text": "かしこまりました。おなまえとパスポートをおねがいします。"
  },
  "hotel-h3": {
    "file": "hotel-h3.mp3",
    "hash": "6ab773a1efc2",
    "voice": "ja-JP-NanamiNeural",
    "text": "たなかさまですね。きょうからにはくですね。おへやはごかいです。"
  },
  "hotel-h4": {
    "file": "hotel-h4.mp3",
    "hash": "92fac3983aef",
    "voice": "ja-JP-NanamiNeural",
    "text": "こちらがへやのかぎです。ごゆっくりどうぞ。"
  },
  "hotel-h5": {
    "file": "hotel-h5.mp3",
    "hash": "4d5828c29047",
    "voice": "ja-JP-NanamiNeural",
    "text": "あさごはんはしちじからくじまでです。にかいです。"
  },
  "hotel-h6": {
    "file": "hotel-h6.mp3",
    "hash": "a734042f9c17",
    "voice": "ja-JP-NanamiNeural",
    "text": "いってらっしゃいませ！ごゆっくりおすごしください。"
  },
  "drug-d1": {
    "file": "drug-d1.mp3",
    "hash": "1818d6f8efd7",
    "voice": "ja-JP-KeitaNeural",
    "text": "いらっしゃいませ！なにかおさがしですか。"
  },
  "drug-d2": {
    "file": "drug-d2.mp3",
    "hash": "363fdf9e17fe",
    "voice": "ja-JP-KeitaNeural",
    "text": "はい、めぐすりはこちらです。こちらがやすいですよ。"
  },
  "drug-d3": {
    "file": "drug-d3.mp3",
    "hash": "f4123e06aa02",
    "voice": "ja-JP-KeitaNeural",
    "text": "ひとつごひゃくえんです。おいくつにしますか。"
  },
  "drug-d4": {
    "file": "drug-d4.mp3",
    "hash": "84150dcd48d4",
    "voice": "ja-JP-KeitaNeural",
    "text": "はい、ひやけどめもごいっしょですね。レジへどうぞ。"
  },
  "drug-d5": {
    "file": "drug-d5.mp3",
    "hash": "3db4e088bdac",
    "voice": "ja-JP-KeitaNeural",
    "text": "はい、めんぜいできますよ。おしはらいはどうなさいますか。"
  },
  "drug-d6": {
    "file": "drug-d6.mp3",
    "hash": "02b3fea3323a",
    "voice": "ja-JP-KeitaNeural",
    "text": "かしこまりました。ふくろはいりますか。"
  },
  "drug-d7": {
    "file": "drug-d7.mp3",
    "hash": "e6e136606835",
    "voice": "ja-JP-KeitaNeural",
    "text": "ありがとうございました！またおこしくださいませ。"
  },
  "station-s1": {
    "file": "station-s1.mp3",
    "hash": "cc897f59797b",
    "voice": "ja-JP-NanamiNeural",
    "text": "あ、はい。どうしましたか。"
  },
  "station-s2": {
    "file": "station-s2.mp3",
    "hash": "45a8491410bd",
    "voice": "ja-JP-NanamiNeural",
    "text": "ここをまっすぐいって、みぎにまがってください。"
  },
  "station-s3": {
    "file": "station-s3.mp3",
    "hash": "26f295756e57",
    "voice": "ja-JP-NanamiNeural",
    "text": "はい、そうです。ちなみに、どこへいきますか。"
  },
  "station-s4": {
    "file": "station-s4.mp3",
    "hash": "daf4f8246052",
    "voice": "ja-JP-NanamiNeural",
    "text": "しんじゅくですね。えきはとてもちかいですよ。"
  },
  "station-s5": {
    "file": "station-s5.mp3",
    "hash": "5638ff383ae1",
    "voice": "ja-JP-NanamiNeural",
    "text": "ええ、そうです。ひだりがわにかいさつがありますよ。しんじゅくへはちゅうおうせんがべんりですよ。"
  },
  "station-s6": {
    "file": "station-s6.mp3",
    "hash": "2631aed46ed4",
    "voice": "ja-JP-NanamiNeural",
    "text": "でぐちのあんないもみやすいので、すぐわかりますよ！"
  },
  "station-s7": {
    "file": "station-s7.mp3",
    "hash": "d917b537a420",
