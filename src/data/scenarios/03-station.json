        "afterTokens": [
          { "text": "行きます", "reading": "いきます", "vocabId": "iku" },
          { "text": "。" }
        ],
        "choices": [
          {
            "text": "に",
            "correct": true,
            "explanationZh": "答對！移動的目的地（新宿）後面用「に」，交通工具（電車）已經用了「で」。"
          },
          {
            "text": "で",
            "correct": false,
            "explanationZh": "「で」是交通工具或動作場所，移動目的地要用「に」（或「へ」）。"
          },
          {
            "text": "を",
            "correct": false,
            "explanationZh": "「行く」的目的地不能接「を」，請用「に」。"
          }
        ],
        "grammarTipId": "ni-destination",
        "targetVocabIds": ["densha", "shinjuku", "iku"]
      }
    },
