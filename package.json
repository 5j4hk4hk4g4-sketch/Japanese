    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.3",
    "typescript": "~5.7.3",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^0.21.1",
